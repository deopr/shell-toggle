# shell-toggle configuration.
#
# Sourced by shell-toggle, shell-start, shellctl and wallpaper-sync. It is
# plain bash, but you only need assignments and arrays.
#
# To add a shell: append its id to SHELLS and add a shell_<id>_* block
# below. `shell-toggle toggle` walks SHELLS in order, so two entries are
# just the smallest rotation. Ids must match [A-Za-z_][A-Za-z0-9_]*.

SHELLS=(dms caelestia)

# Where this config, its adapters and wallpaper providers live.
SHELL_TOGGLE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shell-toggle"

# --- shared settings ------------------------------------------------------

# Optional: symlink that shell-toggle repoints at binds-<binds>.conf.
# Remove this line (or point it elsewhere) to disable keybind swapping.
BINDS_LINK="$HOME/.config/mango/cfg/binds-active.conf"

SPAWN_TIMEOUT="6"     # max seconds to wait for a launched shell to appear
REAP_GRACE="0.25"     # seconds between TERM and KILL when reaping
DEFAULT_WARMUP="0.35" # per-shell override available below
SYNC_WALLPAPER="1"    # run wallpaper-sync --once before switching
WALLPAPER_POLL="1"    # wallpaper-sync daemon poll interval
NOTIFY="1"            # desktop notifications

# --- DMS ------------------------------------------------------------------
# DankMaterialShell runs as one `dms run` process that also owns a
# quickshell UI child. `match` uses the exact process name because the
# dms CLI (`dms run`, `dms kill`, ...) shares it; argv matching would see
# the CLI calls too.
shell_dms_name="DankMaterialShell"
shell_dms_match=(-x dms)
shell_dms_also_match=(-f '^(/[^ ]*/)?qs -p /run/user/[0-9]+/danklinux-shell/')
shell_dms_launch=(dms run)
shell_dms_stop=(dms kill)
shell_dms_warmup="0.45"
shell_dms_binds="dms"
shell_dms_adapter="$SHELL_TOGGLE_DIR/adapters/dms"
shell_dms_wallpaper="$SHELL_TOGGLE_DIR/wallpaper/dms"

# --- Caelestia ------------------------------------------------------------
# Caelestia is a quickshell config. Anchoring the pattern to the whole
# argv keeps it from matching DMS's quickshell UI (or the toggle itself).
shell_caelestia_name="Caelestia"
shell_caelestia_match=(-f '^(/[^ ]*/)?qs -c caelestia$')
shell_caelestia_launch=(qs -c caelestia)
shell_caelestia_env=(
    CAELESTIA_LIB_DIR=/usr/lib64/caelestia
    CAELESTIA_XKB_RULES_PATH=/usr/share/X11/xkb/rules/base.lst
)
shell_caelestia_warmup="0.40"
shell_caelestia_binds="caelestia"
shell_caelestia_adapter="$SHELL_TOGGLE_DIR/adapters/caelestia"
shell_caelestia_wallpaper="$SHELL_TOGGLE_DIR/wallpaper/caelestia"

