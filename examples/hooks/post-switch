#!/usr/bin/env bash
# post-switch: runs after a shell has started and the binds symlink moved.
#
# Reloading is compositor-specific. This hook auto-detects the common ones
# and is a no-op elsewhere, so it is safe to leave installed.
#
# Mango's auto_reload_config already picks up the symlink; no reload needed.
# niri reloads its config automatically.

if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || true
elif [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1; then
    swaymsg reload >/dev/null 2>&1 || true
fi
